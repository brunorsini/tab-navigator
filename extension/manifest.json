{
  "manifest_version": 3,
  "name": "Tab Navigator",
  "short_name": "Tab Navigator",
  "description": "Find the right tab instantly. Search tabs and history, jump to your last tab, and cycle through recent tabs. All on your device.",
  "version": "1.7.0",
  "minimum_chrome_version": "127",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage", "history", "scripting", "favicon"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Navigator — Find a tab",
    "default_popup": "popup.html?ui=1.7.0",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png",
      "48": "icons/toolbar-48.png",
      "128": "icons/toolbar-128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "MacCtrl+E"
      }
    },
    "toggle-last": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Switch to the last tab (press again to return)"
    },
    "cycle-older": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Cycle recent tabs forward (older)"
    },
    "cycle-newer": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Cycle recent tabs backward (newer)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; form-action 'none'"
  }
}
